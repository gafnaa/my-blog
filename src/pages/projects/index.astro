---
import { Button, Icon } from 'astro-pure/user'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'featured-projects', text: 'Featured Projects' },
  { depth: 2, slug: 'cybersecurity', text: 'Cybersecurity' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>
    A curated selection of projects I have built across desktop tools, web development, automation,
    and cybersecurity.
  </p>
  <Button title='View all repositories' class='w-fit' href='https://github.com/gafnaa' target='_blank'>
    <Icon class='size-5' name='github' slot='before' />
  </Button>

  <p>GitHub Activities:</p>
  <p>
    <img
      src='https://ghchart.rshah.org/659eb9/gafnaa'
      alt='Gafna GitHub contribution activity'
      loading='lazy'
      decoding='async'
      width='663'
      height='104'
    />
  </p>

  <h2 id='featured-projects'>Featured Projects</h2>
  <ProjectSection
    projects={[
      {
        name: 'MediaSort',
        description:
          'A desktop tool for quickly reviewing, sorting, and organizing photos, RAW images, and videos.',
        links: [{ type: 'github', href: 'https://github.com/gafnaa/MediaSort' }]
      },
      {
        name: 'KKN Sokasik',
        description:
          'An automation dashboard for managing KKN logbooks, attendance, schedules, and reports.',
        links: [
          { type: 'github', href: 'https://github.com/gafnaa/kkn-sokasik' },
          { type: 'site', href: 'https://kkn-sokasik-production.up.railway.app/' }
        ]
      },
      {
        name: 'Ekspedisi',
        description:
          'A full-stack expedition management application built with Next.js, Prisma, and PostgreSQL.',
        links: [
          { type: 'github', href: 'https://github.com/gafnaa/ekspedisi' },
          { type: 'site', href: 'https://ekspedisi-production.up.railway.app' }
        ]
      },
      {
        name: 'My Blog',
        description:
          'This responsive portfolio and technical blog for projects, achievements, and CTF writeups.',
        links: [
          { type: 'github', href: 'https://github.com/gafnaa/my-blog' },
          { type: 'site', href: 'https://gafnaworks.vercel.app' }
        ]
      }
    ]}
  />

  <h2 id='cybersecurity'>Cybersecurity</h2>
  <ProjectSection
    projects={[
      {
        name: 'Sankya Trace',
        description: 'An OSINT tool written in Python for finding a username across multiple websites.',
        links: [{ type: 'github', href: 'https://github.com/gafnaa/sankya_trace' }]
      },
      {
        name: 'CTF Archives',
        description:
          'An archive of challenges, competition results, and writeups from CTF events and platforms.',
        links: [{ type: 'github', href: 'https://github.com/gafnaa/ctf-archives' }]
      }
    ]}
  />
</PageLayout>
