---
import AdminLayout from '@/layouts/AdminLayout.astro'
---
<AdminLayout title="Dashboard" active="dashboard">
  <section class="dashboard">
    <header class="page-heading"><div><p class="welcome">Good to see you</p><h1>Your shelf, at a glance.</h1><p class="intro">A quiet corner to keep the books and games you love.</p></div><a class="primary-action" href="/admin/library">＋ Add to library</a></header>
    <div class="overview-grid">
      <article class="overview-card"><span class="overview-icon book-icon">▤</span><div><p>Total collection</p><strong id="total-count">—</strong><small>Books and games</small></div></article>
      <article class="overview-card"><span class="overview-icon game-icon">◈</span><div><p>Games</p><strong id="game-count">—</strong><small>In your collection</small></div></article>
      <article class="overview-card"><span class="overview-icon books-icon">▥</span><div><p>Books</p><strong id="book-count">—</strong><small>On your reading shelf</small></div></article>
      <article class="overview-card"><span class="overview-icon rating-icon">★</span><div><p>Average rating</p><strong id="average-rating">—</strong><small>Out of 5 stars</small></div></article>
    </div>
    <section class="recent-section"><div class="section-heading"><div><h2>Recently added</h2><p>Your latest additions to the shelf</p></div><a href="/admin/library">Manage library <span aria-hidden="true">↗</span></a></div><div id="recent-list" class="recent-list"><p class="loading">Loading your collection…</p></div></section>
    <aside class="shelf-note"><span>✦</span><p><strong>A good collection keeps growing.</strong><br>Save a book or game you want to remember for later.</p><a href="/admin/library">Add something</a></aside>
  </section>
</AdminLayout>
<script>
  const config = { url: import.meta.env.PUBLIC_SUPABASE_URL, key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }
  const session = JSON.parse(sessionStorage.getItem('library-admin-session') || 'null')
  if (!session?.access_token || session.expires_at * 1000 < Date.now()) location.replace('/admin/login')
  const list = document.querySelector<HTMLElement>('#recent-list')!
  const safe = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!)
  const load = async () => {
    if (!config.url || !config.key) { list.textContent = 'Add your Supabase configuration to load the collection.'; return }
    try {
      const response = await fetch(`${config.url}/rest/v1/library?select=*&order=created_at.desc`, { headers: { apikey: config.key, Authorization: `Bearer ${session.access_token}` } })
      if (!response.ok) throw new Error()
      const items = await response.json()
      document.querySelector('#total-count')!.textContent = items.length
      document.querySelector('#game-count')!.textContent = items.filter((item: any) => item.type === 'Game').length
      document.querySelector('#book-count')!.textContent = items.filter((item: any) => item.type === 'Book').length
      const average = items.length ? items.reduce((sum: number, item: any) => sum + Number(item.rating || 0), 0) / items.length : 0
      document.querySelector('#average-rating')!.textContent = items.length ? average.toFixed(1) : '—'
      list.innerHTML = items.slice(0, 5).map((item: any) => `<article class="recent-item"><img src="${safe(item.image)}" alt=""><div class="recent-copy"><strong>${safe(item.title)}</strong><span>${safe(item.creator)}</span></div><span class="item-type ${item.type === 'Game' ? 'game' : 'book'}">${safe(item.type)}</span><span class="item-rating">★ ${safe(item.rating)}</span></article>`).join('') || '<div class="empty-collection"><span>▤</span><p>Your library is waiting for its first addition.</p><a href="/admin/library">Add a book or game</a></div>'
    } catch { list.textContent = 'Could not load the collection. Check your Supabase table and access policies.' }
  }
  if (session?.access_token) load()
</script>
<style>
  .dashboard { max-width: 66rem; margin: 0 auto; }
  .page-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; padding:2.35rem 0 1.8rem; }
  .welcome { margin:0 0 .45rem; color:#728077; font-size:.82rem; }
  h1 { margin:0; font-family:Georgia,serif; font-size:clamp(1.8rem,3vw,2.5rem); font-weight:500; letter-spacing:-.045em; }
  .intro { margin:.55rem 0 0; color:#84908a; font-size:.9rem; }
  .primary-action { flex:none; padding:.7rem .95rem; border-radius:.45rem; background:#377662; color:white; font-size:.82rem; font-weight:600; text-decoration:none; }
  .primary-action:hover { background:#2d6553; }
  .overview-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.85rem; }
  .overview-card { display:flex; align-items:flex-start; gap:.8rem; min-height:8.1rem; padding:1.1rem; border:1px solid #e7eaeb; border-radius:.65rem; background:white; }
  .overview-icon { display:grid; width:2.35rem; height:2.35rem; flex:none; place-items:center; border-radius:.55rem; font-size:1rem; }
  .book-icon { color:#397661; background:#e9f3ef; }.game-icon { color:#786444; background:#f5f0e5; }.books-icon { color:#74709a; background:#efedf7; }.rating-icon { color:#a07833; background:#f8f2e4; }
  .overview-card p { margin:0 0 .28rem; color:#748079; font-size:.76rem; }
  .overview-card strong { display:block; color:#26352e; font-size:1.65rem; font-weight:600; line-height:1.1; }
  .overview-card small { display:block; margin-top:.35rem; color:#a1aaa4; font-size:.69rem; }
  .recent-section { margin-top:2.1rem; }
  .section-heading { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:.8rem; }
  .section-heading h2 { margin:0; font-family:Georgia,serif; font-size:1.35rem; font-weight:500; letter-spacing:-.02em; }
  .section-heading p { margin:.28rem 0 0; color:#8a948e; font-size:.78rem; }
  .section-heading a { color:#397661; font-size:.78rem; font-weight:600; text-decoration:none; }
  .recent-list { overflow:hidden; border:1px solid #e7eaeb; border-radius:.65rem; background:#fff; }
  .recent-item { display:flex; align-items:center; gap:.9rem; min-height:4.5rem; padding:.6rem .85rem; border-bottom:1px solid #eff1f1; }
  .recent-item:last-child { border-bottom:0; }
  .recent-item img { width:2.4rem; height:3rem; border-radius:.25rem; background:#f0f1ef; object-fit:cover; }
  .recent-copy { display:grid; flex:1; gap:.2rem; min-width:0; }.recent-copy strong { overflow:hidden; color:#334139; font-size:.83rem; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }.recent-copy span { color:#8d9791; font-size:.75rem; }
  .item-type { padding:.28rem .5rem; border-radius:99px; font-size:.68rem; }.item-type.book { background:#f0edf7; color:#70678d; }.item-type.game { background:#f6f0e4; color:#877047; }.item-rating { width:3.2rem; color:#8d784e; font-size:.76rem; text-align:right; }
  .loading { margin:0; padding:1.5rem; color:#929b95; font-size:.82rem; }.empty-collection { padding:2rem 1rem; text-align:center; color:#839087; font-size:.85rem; }.empty-collection > span { color:#74a28f; font-size:1.5rem; }.empty-collection p { margin:.5rem 0; }.empty-collection a { color:#397661; font-weight:600; text-decoration:none; }
  .shelf-note { display:flex; align-items:center; gap:.9rem; margin-top:1.25rem; padding:1rem 1.1rem; border-radius:.6rem; background:#edf4f0; color:#657b6f; font-size:.78rem; }.shelf-note > span { color:#57947b; font-size:1.1rem; }.shelf-note p { flex:1; margin:0; line-height:1.6; }.shelf-note strong { color:#426553; font-weight:650; }.shelf-note a { color:#397661; font-weight:650; text-decoration:none; }
  @media(max-width:850px) { .overview-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .admin-main { padding-inline:1.4rem; } }
  @media(max-width:520px) { .page-heading { align-items:flex-start; flex-direction:column; padding-top:1.6rem; }.overview-grid { gap:.6rem; }.overview-card { min-height:7.3rem; padding:.8rem; gap:.55rem; }.overview-card strong { font-size:1.4rem; }.recent-item { gap:.55rem; padding-inline:.6rem; }.item-type { display:none; }.shelf-note { align-items:flex-start; flex-wrap:wrap; }.shelf-note p { min-width:calc(100% - 2.5rem); }.shelf-note a { margin-left:2rem; } }
</style>
