---
import PageLayout from '@/layouts/CommonPage.astro'
import FavoriteCard from '@/components/library/FavoriteCard.astro'

type Favorite = {
  title: string
  creator: string
  type: 'Game' | 'Book'
  rating: number
  description: string
  image: string
  imageAlt: string
}

// Add or edit favorites here. Image URLs can point to local files in /public or remote covers.
const favorites: Favorite[] = [
  {
    title: 'The Legend of Zelda: Breath of the Wild',
    creator: 'Nintendo',
    type: 'Game',
    rating: 5,
    description: 'A beautiful, open-ended adventure that makes every quiet discovery feel like its own little story.',
    image: 'https://images.igdb.com/igdb/image/upload/t_cover_big/co3p2d.jpg',
    imageAlt: 'Breath of the Wild game cover',
  },
  {
    title: 'The Little Prince',
    creator: 'Antoine de Saint-Exupéry',
    type: 'Book',
    rating: 5,
    description: 'A tender, thoughtful reminder to look beyond what is immediately visible.',
    image: 'https://covers.openlibrary.org/b/isbn/9780156012195-L.jpg',
    imageAlt: 'The Little Prince book cover',
  },
  {
    title: 'Stardew Valley',
    creator: 'ConcernedApe',
    type: 'Game',
    rating: 4,
    description: 'A cozy, endlessly charming escape where there is always one more thing to do tomorrow.',
    image: 'https://images.igdb.com/igdb/image/upload/t_cover_big/co1x7d.jpg',
    imageAlt: 'Stardew Valley game cover',
  },
  {
    title: 'The Midnight Library',
    creator: 'Matt Haig',
    type: 'Book',
    rating: 4,
    description: 'An imaginative and heartfelt story about second chances and making peace with the life you have.',
    image: 'https://covers.openlibrary.org/b/isbn/9780525559474-L.jpg',
    imageAlt: 'The Midnight Library book cover',
  },
]

const games = favorites.filter((item) => item.type === 'Game')
const books = favorites.filter((item) => item.type === 'Book')

const headings = [
  { depth: 2, slug: 'games', text: 'Games' },
  { depth: 2, slug: 'books', text: 'Books' },
]

const supabaseConfig = { url: import.meta.env.PUBLIC_SUPABASE_URL, key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }
---

<PageLayout title='Books & Games' {headings}>
  <section aria-labelledby='games'>
    <h2 id='games' class='collection-heading'>Games</h2>
    <div class='favorite-grid'>
      {games.map((item) => <FavoriteCard item={item} />)}
    </div>
  </section>

  <section aria-labelledby='books' class='books-section'>
    <h2 id='books' class='collection-heading'>Books</h2>
    <div class='favorite-grid'>
      {books.map((item) => <FavoriteCard item={item} />)}
    </div>
  </section>
  <script define:vars={{ supabaseConfig }}>
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char])
    const card = (item) => `<article class="favorite-card"><div class="cover-wrap"><img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.imageAlt || item.title)}" loading="lazy"><span class="type-badge ${item.type.toLowerCase()}">${escapeHtml(item.type)}</span></div><div class="card-copy"><div class="rating" aria-label="${item.rating} out of 5 stars">${Array.from({length:5},(_,i)=>`<span class="star ${i < item.rating ? 'filled' : ''}" aria-hidden="true">★</span>`).join('')}</div><h3>${escapeHtml(item.title)}</h3><p class="creator">${escapeHtml(item.creator)}</p><p class="review">${escapeHtml(item.description)}</p></div></article>`
    const render = async () => {
      const { url, key } = supabaseConfig
      if (!url || !key) return
      try {
        const response = await fetch(`${url}/rest/v1/library?select=*&order=created_at.desc`, { headers: { apikey: key, Authorization: `Bearer ${key}` } })
        if (!response.ok) return
        const items = await response.json()
        if (!Array.isArray(items)) return
        for (const type of ['Game', 'Book']) {
          const section = document.querySelector(type === 'Game' ? '[aria-labelledby="games"] .favorite-grid' : '[aria-labelledby="books"] .favorite-grid')
          const entries = items.filter((item) => item.type === type)
          if (section && entries.length) section.innerHTML = entries.map(card).join('')
          else if (section && !entries.length && items.length) section.innerHTML = '<p>No entries yet.</p>'
        }
      } catch (error) { console.error('Could not load library entries', error) }
    }
    render()
  </script>
</PageLayout>

<style>
  .books-section { margin-top: 2.5rem; }
  .collection-heading { margin-bottom: 1rem; }
  .favorite-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 700px) { .favorite-grid { grid-template-columns: 1fr; } }
</style>
