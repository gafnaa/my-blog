---
interface Props {
  item: {
    title: string
    creator: string
    type: 'Game' | 'Book'
    rating: number
    description: string
    image: string
    imageAlt: string
  }
}

const { item } = Astro.props
---

<article class='favorite-card'>
  <div class='cover-wrap'>
    <img src={item.image} alt={item.imageAlt} loading='lazy' />
    <span class:list={['type-badge', item.type.toLowerCase()]}>{item.type}</span>
  </div>
  <div class='card-copy'>
    <div class='rating' aria-label={`${item.rating} out of 5 stars`}>
      {Array.from({ length: 5 }, (_, index) => (
        <span class={index < item.rating ? 'star filled' : 'star'} aria-hidden='true'>★</span>
      ))}
    </div>
    <h3>{item.title}</h3>
    <p class='creator'>{item.creator}</p>
    <p class='review'>{item.description}</p>
  </div>
</article>

<style is:global>
  .favorite-card { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; overflow: hidden; padding: 0.8rem; border: 1px solid hsl(var(--border)); border-radius: 0.85rem; background: hsl(var(--background) / 0.65); transition: border-color 160ms ease, transform 160ms ease; }
  .favorite-card:hover { transform: translateY(-2px); border-color: hsl(var(--primary) / 0.55); }
  .cover-wrap { position: relative; min-height: 10rem; overflow: hidden; border-radius: 0.55rem; background: hsl(var(--muted)); }
  .cover-wrap img { width: 100%; height: 100%; min-height: 10rem; object-fit: cover; }
  .type-badge { position: absolute; top: 0.45rem; left: 0.45rem; padding: 0.2rem 0.5rem; border: 1px solid hsl(var(--border) / 0.7); border-radius: 999px; background: hsl(var(--background) / 0.88); color: hsl(var(--foreground)); font-size: 0.65rem; font-weight: 600; backdrop-filter: blur(8px); }
  .type-badge.game { color: hsl(var(--primary)); }
  .card-copy { align-self: center; min-width: 0; padding: 0.2rem 0.15rem 0.2rem 0; }
  .rating { display: flex; gap: 0.08rem; margin-bottom: 0.35rem; }
  .star { color: hsl(var(--muted-foreground) / 0.32); font-size: 0.85rem; }
  .star.filled { color: #e9ad48; }
  .card-copy h3 { margin: 0; font-size: 0.98rem; line-height: 1.35; }
  .creator { margin: 0.2rem 0 0.55rem; color: hsl(var(--muted-foreground)); font-size: 0.76rem; }
  .review { margin: 0; color: hsl(var(--muted-foreground)); font-size: 0.8rem; line-height: 1.55; }
  @media (max-width: 420px) { .favorite-card { grid-template-columns: 6rem minmax(0, 1fr); gap: 0.75rem; padding: 0.65rem; } .cover-wrap, .cover-wrap img { min-height: 9rem; } .review { font-size: 0.76rem; } }
</style>
